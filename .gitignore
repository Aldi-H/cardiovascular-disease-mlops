# Environment variables and credentials — never commit!
.env
.env.*
!.env.example

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Raw and generated datasets (never commit patient-level data)
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep

# Local model and experiment artifacts
artifacts/
mlruns/
models/
*.joblib
*.pkl

# Local environment / editor files
.DS_Store
.vscode/

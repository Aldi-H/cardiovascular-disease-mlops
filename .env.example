# Copy to .env and fill locally. Never commit .env or real credentials.
CARDIO_DATA_PATH=data/raw/cardiovascular-disease.csv

# DagsHub-hosted MLflow Tracking
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
DAGSHUB_REPO_OWNER=
DAGSHUB_REPO_NAME=

# Backblaze B2 S3-compatible artifact store
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
B2_BUCKET_NAME=
B2_DATA_OBJECT_KEY=datasets/cardiovascular-disease.csv

# MLflow model URI for serving; set to the selected logged run.
MODEL_URI=runs:/<ISI_SENDIRI>/model

# Local Grafana admin login; do not use this placeholder as a real password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<ISI_SENDIRI>
GRAFANA_DISCORD_WEBHOOK_URL=<ISI_SENDIRI>
